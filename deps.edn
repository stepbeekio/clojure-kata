{:paths ["src"]
 :deps  {org.clojure/clojure {:mvn/version "1.12.0"}}
 :aliases
 {:test  {:extra-paths ["test"]
          :extra-deps  {io.github.cognitect-labs/test-runner
                        {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
          :main-opts   ["-m" "cognitect.test-runner"]}
  ;; REPL tooling: Portal + nREPL + FlowStorm. dev/user.clj is loaded automatically.
  ;; FlowStorm runs on ClojureStorm, a drop-in Clojure that records every
  ;; kata.* function call so you can step through it in the debugger.
  :dev   {:extra-paths ["test" "dev"]
          :classpath-overrides {org.clojure/clojure nil}
          :extra-deps  {djblue/portal {:mvn/version "0.68.1"}
                        nrepl/nrepl   {:mvn/version "1.8.0"}
                        com.github.flow-storm/clojure        {:mvn/version "1.12.5-1"}
                        com.github.flow-storm/flow-storm-dbg {:mvn/version "4.8.1"}}
          :jvm-opts    ["-Dclojure.storm.instrumentEnable=true"
                        "-Dclojure.storm.instrumentOnlyPrefixes=kata."]}
  ;; nREPL server with CIDER middleware (completion, docs, test results)
  ;; for editors such as Conjure. Writes .nrepl-port for auto-connect.
  :nrepl {:extra-deps {cider/cider-nrepl {:mvn/version "0.63.1"}}
          :main-opts  ["-m" "nrepl.cmdline"
                       "--middleware" "[cider.nrepl/cider-middleware]"]}}}
