# direnv config for the Clojure katas. Run `direnv allow` after editing.
strict_env

# Reload when the deps change so the checks below re-run.
watch_file deps.edn

# Warn (rather than fail) about missing tools so the shell still loads.
for tool in java clojure just; do
  has "$tool" || log_error "missing '$tool' — see README.md"
done
has watchexec || log_status "optional: 'watchexec' not found (needed for \`just watch\`)"

# Personal overrides (not committed), e.g. JAVA_HOME or extra JVM flags.
source_env_if_exists .envrc.local
